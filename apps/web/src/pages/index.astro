---
import { ArrowRight, Bookmark, MessageCircleMore, Sparkles } from "lucide-react"
import { ApiStatus } from "@/components/ApiStatus"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import AppLayout from "@/layouts/AppLayout.astro"
import { cn } from "@/lib/utils"

const features = [
  {
    icon: Sparkles,
    title: "작품으로 발견",
    description: "경력보다 실제 결과물을 먼저 보고, 함께하고 싶은 사람을 발견해요.",
  },
  {
    icon: MessageCircleMore,
    title: "맥락 있는 스카우트",
    description: "역할과 프로젝트 정보를 담아 부담 없이 협업을 제안해요.",
  },
  {
    icon: Bookmark,
    title: "나만의 후보 모음",
    description: "인상 깊은 포트폴리오를 저장하고 다음 팀빌딩에 활용해요.",
  },
]
---

<AppLayout title="Scouty — 결과물로 시작하는 팀빌딩">
  <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label="Scouty 홈">
      <img src="/brand/scouty.png" alt="" width="40" height="40" class="size-10 rounded-xl" />
      <span class="text-lg font-extrabold tracking-tight">Scouty</span>
    </a>
    <nav aria-label="주요 메뉴" class="flex items-center gap-1">
      <a class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "hidden sm:inline-flex")} href="#how">
        서비스 소개
      </a>
      <a class={buttonVariants({ size: "sm" })} href="/feed">시작하기</a>
    </nav>
  </header>

  <main>
    <section class="relative isolate overflow-hidden px-5 pb-20 pt-20 text-center sm:px-8 sm:pb-28 sm:pt-28">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl">
        <Badge className="mb-6">대학생을 위한 포트폴리오 팀빌딩</Badge>
        <h1 class="text-balance text-4xl font-extrabold leading-tight tracking-[-0.04em] sm:text-6xl">
          스펙보다 결과물로,<br />함께할 사람을 찾아요
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
          포트폴리오를 둘러보고, 필요한 역할을 스카우트하고,<br class="hidden sm:block" />
          좋은 팀의 시작을 더 가볍고 분명하게.
        </p>
        <div id="start" class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a class={buttonVariants({ size: "lg" })} href="/feed">
            포트폴리오 둘러보기 <ArrowRight aria-hidden="true" />
          </a>
          <a class={buttonVariants({ variant: "outline", size: "lg" })} href="#how">
            Scouty 알아보기
          </a>
        </div>
      </div>
    </section>

    <section id="how" class="mx-auto max-w-6xl px-5 pb-24 sm:px-8 sm:pb-32">
      <div class="mb-8 max-w-xl">
        <p class="mb-2 text-sm font-bold text-primary">어떻게 시작하나요?</p>
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">보여주고, 발견하고, 제안해요</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          features.map(({ icon: Icon, title, description }) => (
            <Card className="feature-card h-full">
              <CardHeader>
                <div class="mb-4 flex size-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                  <Icon aria-hidden="true" size={22} strokeWidth={2.2} />
                </div>
                <CardTitle>{title}</CardTitle>
                <CardDescription>{description}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-7 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© 2026 Scouty. 결과물로 시작하는 팀빌딩.</p>
      <ApiStatus client:load />
    </div>
  </footer>
</AppLayout>

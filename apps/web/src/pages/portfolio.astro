---
import { ProjectDetailRoute } from "@/components/ProjectDetail"
import AppLayout from "@/layouts/AppLayout.astro"
---

<AppLayout
  title="프로젝트 — Scouty"
  description="프로젝트 결과물과 작성자를 자세히 살펴보는 Scouty 프로젝트 상세"
>
  <header class="sticky top-0 z-20 border-b bg-background/90 backdrop-blur">
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="Scouty 홈">
        <img src="/brand/scouty.png" alt="" width="36" height="36" class="size-9 rounded-xl" />
        <span class="text-lg font-extrabold tracking-tight">Scouty</span>
      </a>
    </div>
  </header>

  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12" tabindex="-1">
    <ProjectDetailRoute client:only="react" />
  </main>
</AppLayout>

---
import AppLayout from "@/layouts/AppLayout.astro"

interface Props {
  description?: string
  title: string
}

const { description = "결과물로 시작하는 Scouty", title } = Astro.props
---

<AppLayout title={`${title} — Scouty`} description={description}>
  <header class="sticky top-0 z-20 border-b bg-background/90 backdrop-blur">
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href="/feed" class="flex items-center gap-2.5" aria-label="Scouty 피드">
        <img src="/brand/scouty.png" alt="" width="36" height="36" class="size-9 rounded-xl" />
        <span class="text-lg font-extrabold tracking-tight">Scouty</span>
      </a>
      <a href="/feed" class="text-sm font-semibold text-muted-foreground hover:text-foreground">프로젝트 둘러보기</a>
    </div>
  </header>
  <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <slot />
  </main>
</AppLayout>
